Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se a URL ja aponta para dentro de public/, nao reescreve novamente.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Bloqueia acesso direto a arquivos sensiveis na raiz do projeto.
<FilesMatch "^(\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
