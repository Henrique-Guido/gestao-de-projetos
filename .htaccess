Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Se a URL ja aponta para dentro de public/, nao reescreve novamente.
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Nao indexar nada em buscadores, inclusive imagens, CSS e favicon (as paginas
# PHP tambem enviam esse header pelo public/index.php).
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Bloqueia acesso direto a arquivos sensiveis na raiz do projeto.
<FilesMatch "^(\.env|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
