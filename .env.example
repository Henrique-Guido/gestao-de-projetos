APP_NAME="Gestão de Projetos"
APP_URL=http://localhost/gestao-clientes
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo

# Logo da agência, exibido no menu lateral e no login. Caminho dentro de public/
# (ex.: assets/img/logo.png). Vazio = ícone padrão com o APP_NAME.
APP_LOGO=

# Chave usada para criptografar as senhas guardadas (FTP, blogs, WordPress e e-commerce),
# com AES-256-GCM. Trocar a chave torna ilegíveis as senhas já cadastradas.
# Gere uma nova com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestao_projetos
DB_USERNAME=root
DB_PASSWORD=

# Faixas de IP privadas (CIDR, separadas por vírgula) que o teste de FTP e o
# "Verificar tags" podem acessar. Vazio = só IPs públicos.
# Em hospedagens com DNS interno, os domínios hospedados lá resolvem para IPs
# privados de dentro do servidor (na uni5: 10.19.0.0/16).
REDES_INTERNAS_PERMITIDAS=
